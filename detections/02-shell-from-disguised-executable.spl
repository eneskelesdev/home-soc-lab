index=endpoint "Microsoft-Windows-Sysmon"
| spath input=_raw path=Event.System.Provider{@Name} output=lab_Provider
| spath input=_raw path=Event.System.EventID output=lab_EventID
| where lab_Provider="Microsoft-Windows-Sysmon" AND tonumber(lab_EventID)=1
| rex field=_raw "<Data Name=['\"]Image['\"]>(?<lab_Image>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]ParentImage['\"]>(?<lab_ParentImage>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]CommandLine['\"]>(?<lab_CommandLine>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]ProcessGuid['\"]>(?<lab_ProcessGuid>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]ParentProcessGuid['\"]>(?<lab_ParentProcessGuid>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]User['\"]>(?<lab_User>[^<]*)</Data>"
| where match(lab_Image, "(?i)\\\\cmd[.]exe$") AND match(lab_ParentImage, "(?i)[.]pdf[.]exe$")
| table _time host lab_User lab_ParentImage lab_Image lab_CommandLine lab_ProcessGuid lab_ParentProcessGuid
| sort 0 _time
