index=endpoint "Microsoft-Windows-Sysmon"
| spath input=_raw path=Event.System.Provider{@Name} output=lab_Provider
| spath input=_raw path=Event.System.EventID output=lab_EventID
| where lab_Provider="Microsoft-Windows-Sysmon" AND tonumber(lab_EventID)=3
| rex field=_raw "<Data Name=['\"]Image['\"]>(?<lab_Image>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]ProcessGuid['\"]>(?<lab_ProcessGuid>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]SourceIp['\"]>(?<lab_SourceIp>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]SourcePort['\"]>(?<lab_SourcePort>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]DestinationIp['\"]>(?<lab_DestinationIp>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]DestinationPort['\"]>(?<lab_DestinationPort>[^<]*)</Data>"
| rex field=_raw "<Data Name=['\"]Initiated['\"]>(?<lab_Initiated>[^<]*)</Data>"
| where lab_DestinationIp="192.168.20.11" AND tonumber(lab_DestinationPort)=4444
| table _time host lab_Image lab_ProcessGuid lab_SourceIp lab_SourcePort lab_DestinationIp lab_DestinationPort lab_Initiated
| sort 0 _time
